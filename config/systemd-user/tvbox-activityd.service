[Unit]
Description=TVBox approved physical input activity observer
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=TVBOX_RUNTIME_ROOT=%t/tvbox
Environment=TVBOX_IDLE_CONFIG=%h/.config/tvbox/idle.toml
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/tvbox-activityd run
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
