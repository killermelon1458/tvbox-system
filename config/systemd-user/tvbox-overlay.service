[Unit]
Description=TVBox visible overlay manager
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=TVBOX_RUNTIME_ROOT=%t/tvbox
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/tvbox-overlay
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes

[Install]
WantedBy=default.target
