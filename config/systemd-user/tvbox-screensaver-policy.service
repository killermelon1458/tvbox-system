[Unit]
Description=TVBox manual screensaver and schedule policy
After=tvbox-overlay.service
Requires=tvbox-overlay.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=TVBOX_RUNTIME_ROOT=%t/tvbox
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/tvbox-screensaverd
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
