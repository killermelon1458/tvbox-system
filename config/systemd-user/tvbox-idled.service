[Unit]
Description=TVBox canonical idle-state engine
After=tvbox-activityd.service
Requires=tvbox-activityd.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=TVBOX_RUNTIME_ROOT=%t/tvbox
Environment=TVBOX_IDLE_CONFIG=%h/.config/tvbox/idle.toml
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/tvbox-idled run
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
