#!/bin/bash

/usr/local/bin/tvbox-stop-spotify 2>/tmp/tvbox-stop-spotify.log || true


# Launch YouTube TV web app mode in Chromium.
# Flow:
#   close Kodi -> launch YouTube in Chromium app mode -> relaunch Kodi after Chromium exits

USER_ID="$(id -u)"

# Target the active local GUI session, even when launched from SSH.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$USER_ID}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for sock in "$XDG_RUNTIME_DIR"/wayland-*; do
        if [ -S "$sock" ]; then
            export WAYLAND_DISPLAY="$(basename "$sock")"
            break
        fi
    done
fi

export DISPLAY="${DISPLAY:-:0}"

# Close Kodi so Chromium gets the screen/audio/input resources.
pkill -TERM -x kodi 2>/dev/null
pkill -TERM -x kodi.bin 2>/dev/null
sleep 2

# Force kill only if Kodi did not close.
pkill -KILL -x kodi 2>/dev/null
pkill -KILL -x kodi.bin 2>/dev/null

CHROME="/usr/bin/chromium"
PROFILE="$HOME/.config/chromium-tvbox-youtube"

if [ ! -x "$CHROME" ]; then
    echo "Chromium not found at $CHROME"
    exit 1
fi

"$CHROME" \
  --user-data-dir="$PROFILE" \
  --no-first-run \
  --disable-session-crashed-bubble \
  --password-store=basic \
  --start-fullscreen \
  --user-agent="Mozilla/5.0 (SMART-TV; Linux; Tizen 7.0) AppleWebKit/537.36 (KHTML, like Gecko) SamsungBrowser/5.0 Chrome/108.0.0.0 Safari/537.36" \
  --app="https://www.youtube.com/tv"

# When Chromium exits, relaunch Kodi through the known-good wrapper.
/usr/local/bin/tvbox-kodi
