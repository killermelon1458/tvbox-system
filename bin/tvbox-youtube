#!/bin/bash

# Launch YouTube TV web app mode in Chromium.
# Flow:
#   close Kodi -> launch YouTube in Chromium app mode -> relaunch Kodi after Chromium exits

/usr/local/bin/tvbox-stop-spotify 2>/tmp/tvbox-stop-spotify.log || true

USER_ID="$(id -u)"

# Target the active local GUI session, even when launched from SSH.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$USER_ID}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for sock in "$XDG_RUNTIME_DIR"/wayland-*; do
        if [ -S "$sock" ]; then
            export WAYLAND_DISPLAY="$(basename "$sock")"
            break
        fi
    done
fi

export DISPLAY="${DISPLAY:-:0}"
RUNTIME_ROOT="${TVBOX_RUNTIME_ROOT:-$XDG_RUNTIME_DIR/tvbox}"
mkdir -p "$RUNTIME_ROOT"
chmod 700 "$RUNTIME_ROOT" 2>/dev/null || true

/usr/local/bin/tvbox-screensaver stop >/dev/null 2>&1 || true
/usr/local/bin/tvbox-inputctl set-profile controller_kbm_generic 2>/tmp/tvbox-inputctl-youtube.log || true
/usr/local/bin/tvbox-state ensure-request youtube >/dev/null 2>&1 || true
/usr/local/bin/tvbox-state phase client-starting --application youtube >/dev/null 2>&1 || true

# Close Kodi so Chromium gets the screen/audio/input resources.
pkill -TERM -x kodi 2>/dev/null
pkill -TERM -x kodi.bin 2>/dev/null
sleep 2

# Force kill only if Kodi did not close.
pkill -KILL -x kodi 2>/dev/null
pkill -KILL -x kodi.bin 2>/dev/null

CHROME="/usr/bin/chromium"
PROFILE="$HOME/.config/chromium-tvbox-youtube"

if [ ! -x "$CHROME" ]; then
    echo "Chromium not found at $CHROME"
    exit 1
fi

/usr/local/bin/tvbox-state phase client-starting --application youtube >/dev/null 2>&1 || true
"$CHROME" \
  --user-data-dir="$PROFILE" \
  --no-first-run \
  --disable-session-crashed-bubble \
  --password-store=basic \
  --start-fullscreen \
  --user-agent="Mozilla/5.0 (SMART-TV; Linux; Tizen 7.0) AppleWebKit/537.36 (KHTML, like Gecko) SamsungBrowser/5.0 Chrome/108.0.0.0 Safari/537.36" \
  --app="https://www.youtube.com/tv" &
chrome_pid=$!
/usr/local/bin/tvbox-state attach-pid "$chrome_pid" >/dev/null 2>&1 || true
/usr/local/bin/tvbox-state reconcile youtube --wait 20 >/dev/null 2>&1 || true
wait "$chrome_pid"
chrome_rc=$?
/usr/local/bin/tvbox-state client-exit youtube "$chrome_rc" >/dev/null 2>&1 || true

# When Chromium exits, relaunch Kodi through the known-good wrapper.
if /usr/local/bin/tvbox-state is-stable kodi >/dev/null 2>&1; then
  exit "$chrome_rc"
fi
/usr/local/bin/tvbox-state ensure-request kodi >/dev/null 2>&1 || true
/usr/local/bin/tvbox-state phase returning --application kodi >/dev/null 2>&1 || true
/usr/local/bin/tvbox-kodi
/usr/local/bin/tvbox-state reconcile kodi --returning --wait 15 >/dev/null 2>&1 || \
  /usr/local/bin/tvbox-state fail youtube-kodi-return-failed >/dev/null 2>&1 || true
exit "$chrome_rc"
