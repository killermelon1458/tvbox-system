#!/bin/bash

set -u

CONFIG="/etc/tvboxctl.conf"

# Defaults. /etc/tvboxctl.conf can override these.
TVBOX_USER="tvbox"
TVBOX_UID="1000"
STATE_DIR=""
FALLBACK_STATE_DIR="/tmp/tvbox"
LOG_DIR="/home/tvbox/.cache"

KODI_WRAPPER="/usr/local/bin/tvbox-kodi"
KODI_JSONRPC_URL="http://127.0.0.1:8080/jsonrpc"
YOUTUBE_WRAPPER="/usr/local/bin/tvbox-youtube"
YOUTUBE_PROFILE="/home/tvbox/.config/chromium-tvbox-youtube"

SPOTIFY_STOP="/usr/local/bin/tvbox-stop-spotify"
SPOTIFY_PROFILE="/home/tvbox/.config/chromium-tvbox-spotify-ui"
SPOTIFY_USER_SERVICE="tvbox-spotify-mode.service"

MOONLIGHT_STOP_SOFT="/usr/local/bin/tvbox-stop-moonlight"
MOONLIGHT_STOP_HARD="/usr/local/bin/tvbox-quit-moonlight-session"
MOONLIGHT_HOST="192.168.1.189"
STEAMLINK_BIN="/usr/bin/steamlink"
MARIOKART64_WRAPPER="/usr/local/bin/tvbox-mariokart64"
INPUTCTL="/usr/local/bin/tvbox-inputctl"
STATECTL="/usr/local/bin/tvbox-state"

MAX_PRESERVED_APPS=0
EXIT_CLOSES_KODI=0
INPUT_RECOVERY_PRESERVE_EXISTING_BEHAVIOR=1
INPUT_RECOVERY_ON_TRANSITION_FAILURE="restore-kodi-after-kodi-ready"

if [ -f "$CONFIG" ]; then
  # shellcheck source=/dev/null
  . "$CONFIG"
fi

if [ -z "$STATE_DIR" ]; then
  STATE_DIR="${TVBOX_RUNTIME_ROOT:-${XDG_RUNTIME_DIR:-/run/user/$TVBOX_UID}/tvbox}"
fi

if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
  STATE_DIR="$FALLBACK_STATE_DIR"
  mkdir -p "$STATE_DIR"
fi
chmod 700 "$STATE_DIR" 2>/dev/null || true

mkdir -p "$LOG_DIR"

ACTIVE_CONTEXT_FILE="$STATE_DIR/active-context"
PRESERVED_APP_FILE="$STATE_DIR/preserved-app"
PRESERVED_SINCE_FILE="$STATE_DIR/preserved-since"
LOCK_FILE="$STATE_DIR/lock"
LOG_FILE="$LOG_DIR/tvboxctl.log"
RECOVERY_LOG_FILE="$LOG_DIR/tvbox-recovery.log"
HOME_BUTTON_STATE_FILE="$STATE_DIR/button-home-state"
EXIT_BUTTON_STATE_FILE="$STATE_DIR/button-exit-state"
LAST_PANIC_FILE="$STATE_DIR/last-panic"
KODI_FAVOURITES_HINT_FILE="$STATE_DIR/kodi-favourites-hint"

HOME_COUNTER_WINDOW=10
EXIT_COUNTER_WINDOW=8
PANIC_PRESS_THRESHOLD=5

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
  logger -t tvboxctl "$*" 2>/dev/null || true
}

log_recovery() {
  printf '%s %s\n' "$(date -Is 2>/dev/null || date)" "$*" >> "$RECOVERY_LOG_FILE"
}

button_state_file() {
  case "${1:-}" in
    home)
      printf '%s\n' "$HOME_BUTTON_STATE_FILE"
      ;;
    exit)
      printf '%s\n' "$EXIT_BUTTON_STATE_FILE"
      ;;
    *)
      return 1
      ;;
  esac
}

button_press_count() {
  local button="${1:-}"
  local window="${2:-8}"
  local file now prev_ts prev_count count

  file="$(button_state_file "$button")" || return 1
  now="$(date +%s)"
  prev_ts=0
  prev_count=0

  if [ -r "$file" ]; then
    read -r prev_ts prev_count < "$file" || true
  fi

  if [ "$prev_ts" -gt 0 ] 2>/dev/null && [ $((now - prev_ts)) -le "$window" ] 2>/dev/null; then
    count=$((prev_count + 1))
  else
    count=1
  fi

  printf '%s %s\n' "$now" "$count" > "$file"
  printf '%s\n' "$count"
}

clear_button_counters() {
  rm -f "$HOME_BUTTON_STATE_FILE" "$EXIT_BUTTON_STATE_FILE"
}

mark_kodi_favourites() {
  date +%s > "$KODI_FAVOURITES_HINT_FILE" 2>/dev/null || true
}

clear_kodi_favourites_hint() {
  rm -f "$KODI_FAVOURITES_HINT_FILE"
}

kodi_favourites_hint_fresh() {
  local now hint_ts

  [ -r "$KODI_FAVOURITES_HINT_FILE" ] || return 1
  now="$(date +%s)"
  hint_ts="$(cat "$KODI_FAVOURITES_HINT_FILE" 2>/dev/null || printf '0')"

  [ "$hint_ts" -gt 0 ] 2>/dev/null && [ $((now - hint_ts)) -le "$EXIT_COUNTER_WINDOW" ] 2>/dev/null
}

kodi_at_favourites() {
  local response

  if command -v curl >/dev/null 2>&1; then
    response="$(
      curl -fsS --max-time 1 \
        -H 'Content-Type: application/json' \
        --data '{"jsonrpc":"2.0","method":"GUI.GetProperties","params":{"properties":["currentwindow"]},"id":1}' \
        "$KODI_JSONRPC_URL" 2>/dev/null || true
    )"

    if printf '%s\n' "$response" | grep -qi '"label"[[:space:]]*:[[:space:]]*"Favourites"'; then
      return 0
    fi

    if printf '%s\n' "$response" | grep -q '"id"[[:space:]]*:[[:space:]]*10134'; then
      return 0
    fi
  fi

  kodi_favourites_hint_fresh
}

start_bg() {
  # Start a command in the background without passing tvboxctl's lock FD
  # into the child process. If the child inherits FD 9, it can keep the
  # flock alive for the entire lifetime of Kodi/Chromium/etc.
  "$@" 9>&- &
}

set_input_profile() {
  local profile="${1:-}"
  [ -n "$profile" ] || return 0

  if [ -x "$INPUTCTL" ]; then
    "$INPUTCTL" set-profile "$profile" >/dev/null 2>&1 || \
      log "input-profile: failed to set $profile"
  else
    log "input-profile: $INPUTCTL missing or not executable"
  fi
}

input_profile_for_context() {
  case "${1:-}" in
    kodi)
      printf 'kodi_native_minimal\n'
      ;;
    youtube)
      printf 'controller_kbm_generic\n'
      ;;
    spotify)
      printf 'spotify_ui\n'
      ;;
    desktop)
      printf 'controller_kbm_generic\n'
      ;;
    steamlink|moonlight)
      printf 'passthrough\n'
      ;;
    mariokart64)
      printf 'mariokart_n64\n'
      ;;
  esac
}

focus_kodi() {
  # Kodi's labwc/wlrctl app_id is capitalized: Kodi
  if command -v wlrctl >/dev/null 2>&1; then
    wlrctl window focus Kodi >/dev/null 2>&1 || \
    wlrctl toplevel focus Kodi >/dev/null 2>&1 || true
  fi
}



show_kodi() {
  # Launch or assert Kodi through the canonical idempotent wrapper,
  # then focus it if labwc/wlrctl can see the window.
  set_input_profile "kodi_native_minimal"
  start_bg "$KODI_WRAPPER"

  for _ in 1 2 3 4 5 6; do
    sleep 0.5
    if kodi_running; then
      focus_kodi
      focus_kodi
      mark_kodi_favourites
      return 0
    fi
  done

  focus_kodi
  focus_kodi
  mark_kodi_favourites
}

close_kodi_to_desktop() {
  log "exit: closing Kodi to desktop"
  clear_kodi_favourites_hint
  kodi-send --action="PlayerControl(Stop)" >/dev/null 2>&1 || true
  sleep 1
  pkill -TERM -x kodi.bin 2>/dev/null || true
  pkill -TERM -x kodi 2>/dev/null || true
  sleep 3
  pkill -KILL -x kodi.bin 2>/dev/null || true
  pkill -KILL -x kodi 2>/dev/null || true
  set_context "desktop"
  clear_preserved
}

capture_panic_snapshot() {
  local stamp snapshot f

  stamp="$(date '+%Y%m%d-%H%M%S')"
  snapshot="$LOG_DIR/tvbox-panic-snapshot-$stamp.log"

  {
    date -Is 2>/dev/null || date
    printf '\n--- tvboxctl status ---\n'
    status || true
    printf '\n--- kodi processes ---\n'
    pgrep -a kodi || true
    pgrep -a kodi.bin || true
    printf '\n--- chromium tvbox profiles ---\n'
    pgrep -af 'chromium.*chromium-tvbox' || true
    printf '\n--- moonlight processes ---\n'
    pgrep -a moonlight-qt || true
    pgrep -a moonlight || true
    printf '\n--- steamlink processes ---\n'
    pgrep -a steamlink || true
    printf '\n--- windows ---\n'
    wlrctl toplevel list 2>/dev/null || wlrctl window list 2>/dev/null || true
    printf '\n--- HDMI DRM state ---\n'
    for f in /sys/class/drm/card*-HDMI-A-*/status /sys/class/drm/card*-HDMI-A-*/modes /sys/class/drm/card*-HDMI-A-*/enabled; do
      [ -e "$f" ] || continue
      printf -- '--- %s ---\n' "$f"
      cat "$f" 2>/dev/null || true
    done
    printf '\n--- kodi.log tail ---\n'
    tail -n 80 /home/tvbox/.kodi/temp/kodi.log 2>/dev/null || true
    printf '\n--- display journal tail ---\n'
    journalctl -b --no-pager 2>/dev/null | grep -Ei 'vc4|hdmi|cec|drm|wayland|labwc|packet ram|hotplug|disconnect|connect' | tail -n 120 || true
  } > "$snapshot" 2>&1

  log "panic snapshot: $snapshot"
  log_recovery "snapshot=$snapshot"
}

recover_kodi_hard() {
  log "recover kodi-hard: hard restarting Kodi"
  kodi-send --action="PlayerControl(Stop)" >/dev/null 2>&1 || true
  pkill -TERM -x kodi.bin 2>/dev/null || true
  pkill -TERM -x kodi 2>/dev/null || true
  sleep 4
  pkill -KILL -x kodi.bin 2>/dev/null || true
  pkill -KILL -x kodi 2>/dev/null || true
  sleep 2
  show_kodi
  set_context "kodi"
  clear_preserved
}

recover_panic_local() {
  log "recover panic-local requested; context=$(get_context)"
  log_recovery "button=${1:-unknown} count=${2:-0} context=$(get_context) action=panic-home reason=repeated-press"
  date -Is 2>/dev/null > "$LAST_PANIC_FILE" || date > "$LAST_PANIC_FILE"

  capture_panic_snapshot

  "$SPOTIFY_STOP" 2>/tmp/tvbox-stop-spotify.log || true
  close_youtube_current || true
  close_steamlink_current || true
  "$MOONLIGHT_STOP_SOFT" 2>/tmp/tvbox-stop-moonlight.log || true
  pkill -TERM -x mupen64plus 2>/dev/null || true
  sleep 1
  pkill -KILL -x mupen64plus 2>/dev/null || true

  recover_kodi_hard
  clear_button_counters
}

recover_exit_panic_local() {
  log "recover exit-panic-local requested; context=$(get_context)"
  log_recovery "button=${1:-exit} count=${2:-0} context=$(get_context) action=panic-exit reason=repeated-press"
  date -Is 2>/dev/null > "$LAST_PANIC_FILE" || date > "$LAST_PANIC_FILE"

  capture_panic_snapshot

  "$SPOTIFY_STOP" 2>/tmp/tvbox-stop-spotify.log || true
  close_youtube_current || true
  close_steamlink_current || true
  "$MOONLIGHT_STOP_HARD" 2>/tmp/tvbox-quit-moonlight-session.log || true
  pkill -TERM -x mupen64plus 2>/dev/null || true
  sleep 1
  pkill -KILL -x mupen64plus 2>/dev/null || true

  close_kodi_to_desktop
  set_context "desktop"
  clear_preserved
  clear_button_counters
}

usage() {
  cat <<USAGE
Usage:
  tvboxctl status
  tvboxctl get-context
  tvboxctl set-context <context>
  tvboxctl get-preserved
  tvboxctl set-preserved <app>
  tvboxctl clear-preserved
  tvboxctl evict-preserved
  tvboxctl reconcile-context [reason]
  tvboxctl recover <kodi-hard|panic-local|exit-panic-local>
  tvboxctl home
  tvboxctl exit
  tvboxctl menu
  tvboxctl launch <youtube|plex|moonlight|steamlink|mariokart64> [target]
USAGE
}

with_lock() {
  exec 9>"$LOCK_FILE"
  flock -n 9
}

with_lock_wait() {
  local timeout="${1:-2}"
  exec 9>"$LOCK_FILE"
  flock -w "$timeout" 9
}

get_context() {
  if [ -s "$ACTIVE_CONTEXT_FILE" ]; then
    cat "$ACTIVE_CONTEXT_FILE"
  else
    printf 'unknown\n'
  fi
}

set_context() {
  local ctx="${1:-unknown}"
  local profile

  if [ -x "$STATECTL" ]; then
    case "$ctx" in
      kodi|moonlight|steamlink|youtube|mariokart64)
        "$STATECTL" startup >/dev/null 2>&1 || true
        if [ "$(get_context)" != "$ctx" ]; then
          log "active-context not committed: $ctx acceptance predicate failed"
          return 1
        fi
        ;;
      *)
        printf '%s\n' "$ctx" > "$ACTIVE_CONTEXT_FILE"
        ;;
    esac
  else
    printf '%s\n' "$ctx" > "$ACTIVE_CONTEXT_FILE"
  fi

  profile="$(input_profile_for_context "$ctx")"
  set_input_profile "$profile"
  log "active-context=$ctx"
}

state_request() {
  [ -x "$STATECTL" ] || return 0
  "$STATECTL" request "$@" >/dev/null
}

state_ensure_request() {
  [ -x "$STATECTL" ] || return 0
  "$STATECTL" ensure-request "$@" >/dev/null
}

state_phase() {
  [ -x "$STATECTL" ] || return 0
  "$STATECTL" phase "$@" >/dev/null
}

return_to_kodi() {
  local reason="${1:-return}"

  log "$reason: beginning bounded Kodi return"
  state_ensure_request kodi || true
  state_phase returning --application kodi || true
  show_kodi
  if [ -x "$STATECTL" ] && "$STATECTL" reconcile kodi --returning --wait 15; then
    set_input_profile "kodi_native_minimal"
    clear_preserved
    start_bg "$STATECTL" monitor kodi --recover-kodi
    return 0
  fi

  log "$reason: first Kodi readiness wait failed; retrying canonical wrapper once"
  show_kodi
  if [ -x "$STATECTL" ] && "$STATECTL" reconcile kodi --returning --wait 15; then
    set_input_profile "kodi_native_minimal"
    clear_preserved
    start_bg "$STATECTL" monitor kodi --recover-kodi
    return 0
  fi

  log "$reason: bounded Kodi recovery failed"
  [ -x "$STATECTL" ] && "$STATECTL" fail "kodi-recovery-failed:$reason" >/dev/null 2>&1 || true
  return 1
}

recover_transition_failure() {
  local reason="${1:-transition-failure}"

  case "$INPUT_RECOVERY_ON_TRANSITION_FAILURE" in
    restore-kodi-after-kodi-ready)
      return_to_kodi "$reason"
      ;;
    none)
      log "$reason: automatic Kodi recovery disabled by configuration"
      return 1
      ;;
    *)
      log "$reason: unknown input recovery setting: $INPUT_RECOVERY_ON_TRANSITION_FAILURE"
      return 1
      ;;
  esac
}

get_preserved() {
  if [ -s "$PRESERVED_APP_FILE" ]; then
    cat "$PRESERVED_APP_FILE"
  else
    printf '\n'
  fi
}

set_preserved() {
  local app="${1:-}"
  if [ -z "$app" ]; then
    clear_preserved
    return 0
  fi

  printf '%s\n' "$app" > "$PRESERVED_APP_FILE"
  date --iso-8601=seconds > "$PRESERVED_SINCE_FILE" 2>/dev/null || date > "$PRESERVED_SINCE_FILE"
  log "preserved-app=$app"
}

clear_preserved() {
  rm -f "$PRESERVED_APP_FILE" "$PRESERVED_SINCE_FILE"
  log "preserved-app cleared"
}

kodi_running() {
  pgrep -x kodi >/dev/null 2>&1 || pgrep -x kodi.bin >/dev/null 2>&1
}

youtube_running() {
  pgrep -f "chromium.*chromium-tvbox-youtube" >/dev/null 2>&1 || \
  pgrep -f "chromium.*${YOUTUBE_PROFILE}" >/dev/null 2>&1
}

spotify_running() {
  pgrep -f "chromium.*chromium-tvbox-spotify-ui" >/dev/null 2>&1 || \
  pgrep -f "chromium.*${SPOTIFY_PROFILE}" >/dev/null 2>&1 || \
  XDG_RUNTIME_DIR="/run/user/$TVBOX_UID" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$TVBOX_UID/bus" \
    systemctl --user is-active --quiet "$SPOTIFY_USER_SERVICE" 2>/dev/null
}

moonlight_running() {
  pgrep -x moonlight-qt >/dev/null 2>&1 || pgrep -x moonlight >/dev/null 2>&1
}

steamlink_window_running() {
  command -v wlrctl >/dev/null 2>&1 || return 1

  # Steam Link window states observed:
  #   shell: SteamLink
  #   shell: <game name> [Streaming]
  wlrctl window list 2>/dev/null | grep -qE '^shell:[[:space:]]+(SteamLink|Streaming Client|.* \[Streaming\])$'
}

steamlink_process_running() {
  # Keep this narrow. Broad "steamlink" matching can match tvboxctl itself.
  pgrep -x steamlink >/dev/null 2>&1 || \
  pgrep -af '^/usr/bin/steamlink([[:space:]]|$)' >/dev/null 2>&1
}

steamlink_running() {
  steamlink_window_running || steamlink_process_running
}

mariokart64_running() {
  pgrep -x mupen64plus >/dev/null 2>&1
}

focus_steamlink() {
  command -v wlrctl >/dev/null 2>&1 || return 0

  if wlrctl window list 2>/dev/null | grep -qE '^shell:[[:space:]]+(SteamLink|Streaming Client|.* \[Streaming\])$'; then
    wlrctl window focus shell >/dev/null 2>&1 || true
    return 0
  fi

  wlrctl window focus title:SteamLink >/dev/null 2>&1 || \
  wlrctl toplevel focus title:SteamLink >/dev/null 2>&1 || true
}

close_steamlink_current() {
  log "steamlink: closing Steam Link/streaming window if running"

  if command -v wlrctl >/dev/null 2>&1; then
    # Close launcher state.
    wlrctl window close title:SteamLink >/dev/null 2>&1 || \
    wlrctl toplevel close title:SteamLink >/dev/null 2>&1 || true

    # Close active streaming state.
    if wlrctl window list 2>/dev/null | grep -qE '^shell:[[:space:]]+(SteamLink|Streaming Client|.* \[Streaming\])$'; then
      wlrctl window close shell >/dev/null 2>&1 || true
    fi
  fi

  sleep 2

  pkill -TERM -x steamlink 2>/dev/null || true
  pkill -TERM -f '^/usr/bin/steamlink([[:space:]]|$)' 2>/dev/null || true

  sleep 1

  pkill -KILL -x steamlink 2>/dev/null || true
  pkill -KILL -f '^/usr/bin/steamlink([[:space:]]|$)' 2>/dev/null || true
}

start_steamlink_bg() {
  (
    exec 9>&-
    env \
      HOME=/home/tvbox \
      USER=tvbox \
      LOGNAME=tvbox \
      XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$TVBOX_UID}" \
      WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
      DISPLAY="${DISPLAY:-:0}" \
      "$STEAMLINK_BIN" >> "$LOG_DIR/tvbox-steamlink.log" 2>&1
  ) &
}


bool_word() {
  if "$@"; then
    printf 'yes'
  else
    printf 'no'
  fi
}

status() {
  local ctx preserved since

  ctx="$(get_context)"
  preserved="$(get_preserved)"
  since=""
  if [ -s "$PRESERVED_SINCE_FILE" ]; then
    since="$(cat "$PRESERVED_SINCE_FILE")"
  fi

  cat <<STATUS
tvboxctl status
---------------
state-dir:        $STATE_DIR
active-context:   $ctx
preserved-app:    ${preserved:-none}
preserved-since:  ${since:-none}

process detection
-----------------
kodi-running:      $(bool_word kodi_running)
youtube-running:   $(bool_word youtube_running)
spotify-running:   $(bool_word spotify_running)
moonlight-running: $(bool_word moonlight_running)
steamlink-running: $(bool_word steamlink_running)
mariokart64-running: $(bool_word mariokart64_running)

configured paths
----------------
kodi-wrapper:      $KODI_WRAPPER
kodi-jsonrpc:      $KODI_JSONRPC_URL
youtube-wrapper:   $YOUTUBE_WRAPPER
youtube-profile:   $YOUTUBE_PROFILE
spotify-stop:      $SPOTIFY_STOP
moonlight-soft:    $MOONLIGHT_STOP_SOFT
moonlight-hard:    $MOONLIGHT_STOP_HARD
steamlink-bin:     $STEAMLINK_BIN
mariokart64:       $MARIOKART64_WRAPPER

config
------
MAX_PRESERVED_APPS=$MAX_PRESERVED_APPS
EXIT_CLOSES_KODI=$EXIT_CLOSES_KODI
STATUS
}


close_youtube_current() {
  local pid found=1

  [ -x "$STATECTL" ] || return 1
  while read -r pid; do
    [ -n "$pid" ] || continue
    kill -TERM "$pid" 2>/dev/null || true
    found=0
  done < <("$STATECTL" pids youtube)
  [ "$found" -eq 0 ] || return 1
  sleep 2
  while read -r pid; do
    [ -n "$pid" ] || continue
    kill -KILL "$pid" 2>/dev/null || true
  done < <("$STATECTL" pids youtube)
  return 0
}

reconcile_context() {
  local reason="${1:-manual}"

  if mariokart64_running; then
    log "reconcile-context($reason): mariokart64 detected"
    set_context "mariokart64"
  elif moonlight_running; then
    log "reconcile-context($reason): moonlight detected"
    set_context "moonlight"
  elif spotify_running; then
    log "reconcile-context($reason): spotify detected"
    set_context "spotify"
  elif steamlink_running; then
    log "reconcile-context($reason): steamlink detected"
    set_context "steamlink"
  elif youtube_running; then
    log "reconcile-context($reason): youtube detected"
    set_context "youtube"
  elif kodi_running; then
    log "reconcile-context($reason): kodi detected"
    set_context "kodi"
  else
    log "reconcile-context($reason): no controlled app detected; desktop"
    set_context "desktop"
    clear_preserved
  fi
}

do_home() {
  local press_count="${1:-1}"

  log "home requested; context=$(get_context); count=$press_count"
  log_recovery "button=home count=$press_count context=$(get_context) action=home"

  if [ "$press_count" -ge "$PANIC_PRESS_THRESHOLD" ] 2>/dev/null; then
    recover_panic_local "home" "$press_count"
    exit 0
  fi

  state_request kodi || true
  state_phase returning --application kodi || true

  # Mupen64Plus mode: close the emulator and return to Kodi.
  if mariokart64_running; then
    log "home: mariokart64/mupen64plus detected; closing emulator and returning Kodi"
    pkill -TERM -x mupen64plus 2>/dev/null || true
    sleep 1
    return_to_kodi "home-mariokart64"
    exit 0
  fi

  # Moonlight mode: disconnect local Moonlight client only.
  # This is non-destructive and should not send Sunshine undo.
  if moonlight_running; then
    log "home: moonlight detected; soft-disconnecting local Moonlight"
    "$MOONLIGHT_STOP_SOFT" 2>/tmp/tvbox-stop-moonlight.log || true
    sleep 2

    # If Moonlight was launched outside the tvbox-moonlight wrapper, fall back to Kodi here.
    if ! pgrep -f '/usr/local/bin/tvbox-moonlight' >/dev/null 2>&1; then
      log "home: no tvbox-moonlight wrapper detected; launching Kodi"
      return_to_kodi "home-moonlight"
    else
      log "home: wrapper will also return Kodi; asserting bounded readiness here"
      return_to_kodi "home-moonlight-wrapper"
    fi

    exit 0
  fi

  # Spotify UI mode: stop Spotify playback/mode and return to Kodi.
  if spotify_running; then
    log "home: spotify mode detected; stopping Spotify and returning Kodi"
    "$SPOTIFY_STOP" 2>/tmp/tvbox-stop-spotify.log || true
    sleep 1
    return_to_kodi "home-spotify"
    exit 0
  fi

  # Steam Link mode: close local Steam Link and return to Kodi.
  # V1 policy: do not preserve Steam Link yet.
  if steamlink_running; then
    log "home: steamlink detected; closing Steam Link and returning Kodi"
    close_steamlink_current || true
    sleep 1
    return_to_kodi "home-steamlink"
    exit 0
  fi

  # Kodi/Plex mode: stop playback if any, then open Favourites.
  # Also call the canonical Kodi wrapper afterward so Home can recover from
  # strange desktop states where Kodi is running but not foregrounded.
  if kodi_running; then
    log "home: kodi detected; stopping playback, opening Favourites, asserting Kodi"
    kodi-send --action="PlayerControl(Stop)" >/dev/null 2>&1 || true
    sleep 1
    kodi-send --action="ActivateWindow(FavouritesBrowser)" >/dev/null 2>&1 || true
    mark_kodi_favourites
    return_to_kodi "home-kodi"
    exit 0
  fi

  # YouTube Chromium mode: close YouTube.
  # The current YouTube launcher will then continue and relaunch Kodi.
  if youtube_running; then
    log "home: youtube detected; closing YouTube Chromium"
    close_youtube_current || true
    return_to_kodi "home-youtube"
    exit 0
  fi

  # Fallback: launch Kodi.
  log "home: no known active app; launching Kodi"
  return_to_kodi "home-fallback"
}

do_exit() {
  local press_count="${1:-1}"

  log "exit requested; context=$(get_context); count=$press_count"
  log_recovery "button=exit count=$press_count context=$(get_context) action=exit"

  if [ "$press_count" -ge "$PANIC_PRESS_THRESHOLD" ] 2>/dev/null; then
    recover_exit_panic_local "exit" "$press_count"
    exit 0
  fi

  if mariokart64_running; then
    log "exit: mariokart64/mupen64plus detected; closing emulator and returning Kodi"
    pkill -TERM -x mupen64plus 2>/dev/null || true
    sleep 1
    pkill -KILL -x mupen64plus 2>/dev/null || true
    show_kodi
    set_context "kodi"
    clear_preserved
    exit 0
  fi

  if moonlight_running; then
    log "exit: moonlight detected; running destructive Moonlight quit path"
    "$MOONLIGHT_STOP_HARD" 2>/tmp/tvbox-quit-moonlight-session.log || true
    sleep 2
    show_kodi
    set_context "kodi"
    clear_preserved
    exit 0
  fi

  if spotify_running; then
    log "exit: spotify mode detected; stopping Spotify and returning Kodi"
    "$SPOTIFY_STOP" 2>/tmp/tvbox-stop-spotify.log || true
    sleep 1
    show_kodi
    set_context "kodi"
    clear_preserved
    exit 0
  fi

  if steamlink_running; then
    log "exit: steamlink detected; closing Steam Link and returning Kodi"
    close_steamlink_current || true
    sleep 1
    show_kodi
    set_context "kodi"
    clear_preserved
    exit 0
  fi

  if youtube_running; then
    log "exit: youtube detected; closing YouTube Chromium and returning Kodi"
    close_youtube_current || true
    sleep 1
    show_kodi
    set_context "kodi"
    clear_preserved
    exit 0
  fi

  if kodi_running; then
    if kodi_at_favourites; then
      log "exit: kodi is at Favourites; closing Kodi"
      close_kodi_to_desktop
      clear_button_counters
      exit 0
    fi

    log "exit: kodi detected away from Favourites; opening Favourites"
    kodi-send --action="PlayerControl(Stop)" >/dev/null 2>&1 || true
    sleep 1
    kodi-send --action="ActivateWindow(FavouritesBrowser)" >/dev/null 2>&1 || true
    mark_kodi_favourites
    focus_kodi
    set_context "kodi"
    exit 0
  fi

  log "exit: no known active app; launching Kodi"
  show_kodi
  set_context "kodi"
}



do_launch_steamlink() {
  log "launch steamlink requested; context=$(get_context)"
  state_request steamlink || true
  state_phase client-starting --application steamlink || true
  set_input_profile "passthrough"

  if steamlink_running; then
    log "launch steamlink: already running; focusing existing window"
    focus_steamlink
    "$STATECTL" reconcile steamlink --wait 2 || true
    exit 0
  fi

  # Stop Spotify mode if active.
  if spotify_running; then
    log "launch steamlink: stopping Spotify mode"
    "$SPOTIFY_STOP" 2>/tmp/tvbox-stop-spotify.log || true
    sleep 1
  fi

  # Stop Kodi playback and close Kodi so Steam Link owns the display.
  if kodi_running; then
    log "launch steamlink: stopping Kodi playback and closing Kodi"
    kodi-send --action="PlayerControl(Stop)" >/dev/null 2>&1 || true
    sleep 1
    pkill -TERM -x kodi 2>/dev/null || true
    pkill -TERM -x kodi.bin 2>/dev/null || true
    sleep 2
    pkill -KILL -x kodi 2>/dev/null || true
    pkill -KILL -x kodi.bin 2>/dev/null || true
  fi

  # Close YouTube Chromium mode if present.
  if youtube_running; then
    log "launch steamlink: closing YouTube Chromium"
    close_youtube_current || true
  fi

  log "launch steamlink: starting $STEAMLINK_BIN"
  start_steamlink_bg

  if "$STATECTL" reconcile steamlink --wait 20; then
    focus_steamlink
    start_bg "$STATECTL" monitor steamlink --recover-kodi
    exit 0
  fi

  log "launch steamlink: acceptance failed; returning to Kodi"
  close_steamlink_current || true
  recover_transition_failure "steamlink-launch-failure"
}

do_launch_mariokart64() {
  log "launch mariokart64 requested; context=$(get_context)"
  state_request mariokart64 || true
  state_phase client-starting --application mariokart64 || true
  set_input_profile "passthrough"

  if mariokart64_running; then
    log "launch mariokart64: already running"
    state_phase content-loading --application mariokart64 || true
    exit 0
  fi

  if [ ! -x "$MARIOKART64_WRAPPER" ]; then
    log "launch mariokart64: wrapper missing or not executable: $MARIOKART64_WRAPPER"
    printf 'tvboxctl: missing executable: %s\n' "$MARIOKART64_WRAPPER" >&2
    "$STATECTL" fail "wrapper-missing" >/dev/null 2>&1 || true
    recover_transition_failure "mariokart64-wrapper-missing"
    return 1
  fi

  log "launch mariokart64: starting $MARIOKART64_WRAPPER"
  start_bg "$MARIOKART64_WRAPPER"

  "$STATECTL" reconcile mariokart64 --wait 12
  rc=$?
  if [ "$rc" -eq 0 ]; then
    return 0
  fi
  if [ "$rc" -eq 2 ]; then
    log "launch mariokart64: content-loading; no reliable ready signal"
    # Preserve the existing lifecycle behavior; this is not reconciler policy.
    set_input_profile "mariokart_n64"
    return 0
  fi
  log "launch mariokart64: failed before content loading; returning to Kodi"
  recover_transition_failure "mariokart64-launch-failure"
}

evict_preserved() {
  # Phase 1 skeleton only. Real eviction behavior comes later.
  local preserved
  preserved="$(get_preserved)"
  if [ -z "$preserved" ]; then
    log "evict-preserved: nothing preserved"
    return 0
  fi

  log "evict-preserved requested for $preserved, but eviction is not implemented in skeleton"
  printf 'Eviction not implemented yet. Preserved app is still: %s\n' "$preserved"
}

not_implemented() {
  local cmd="$*"
  log "not implemented: $cmd"
  printf 'tvboxctl: command not implemented yet: %s\n' "$cmd" >&2
  return 2
}

cmd="${1:-}"

case "$cmd" in
  status)
    status
    ;;

  get-context)
    get_context
    ;;

  set-context)
    shift
    if ! with_lock; then
      log "set-context ignored because lock is held"
      exit 0
    fi
    set_context "${1:-unknown}"
    ;;

  get-preserved)
    get_preserved
    ;;

  set-preserved)
    shift
    if ! with_lock; then
      log "set-preserved ignored because lock is held"
      exit 0
    fi
    set_preserved "${1:-}"
    ;;

  clear-preserved)
    if ! with_lock; then
      log "clear-preserved ignored because lock is held"
      exit 0
    fi
    clear_preserved
    ;;

  evict-preserved)
    if ! with_lock; then
      log "evict-preserved ignored because lock is held"
      exit 0
    fi
    evict_preserved
    ;;

  reconcile-context)
    shift
    if ! with_lock; then
      log "reconcile-context ignored because lock is held"
      exit 0
    fi
    reconcile_context "${1:-manual}"
    ;;

  recover)
    shift
    if ! with_lock; then
      log "recover ${1:-} ignored because lock is held"
      exit 0
    fi
    case "${1:-}" in
      kodi-hard)
        recover_kodi_hard
        ;;
      panic-local)
        recover_panic_local "manual" 0
        ;;
      exit-panic-local)
        recover_exit_panic_local "manual" 0
        ;;
      *)
        not_implemented "recover ${*:-}"
        ;;
    esac
    ;;

  home)
    press_count="$(button_press_count home "$HOME_COUNTER_WINDOW" 2>/dev/null || printf '1')"
    if ! with_lock; then
      log "home ignored because lock is held; counted press=$press_count"
      if [ "$press_count" -ge "$PANIC_PRESS_THRESHOLD" ] 2>/dev/null && with_lock_wait 2; then
        recover_panic_local "home" "$press_count"
      fi
      exit 0
    fi
    do_home "$press_count"
    ;;

  exit)
    press_count="$(button_press_count exit "$EXIT_COUNTER_WINDOW" 2>/dev/null || printf '1')"
    if ! with_lock; then
      log "exit ignored because lock is held; counted press=$press_count"
      if [ "$press_count" -ge "$PANIC_PRESS_THRESHOLD" ] 2>/dev/null && with_lock_wait 2; then
        recover_exit_panic_local "exit" "$press_count"
      fi
      exit 0
    fi
    do_exit "$press_count"
    ;;

  menu)
    not_implemented "$cmd"
    ;;

  launch)
    shift
    subcmd="${1:-}"
    case "$subcmd" in
      steamlink)
        if ! with_lock; then
          log "launch steamlink ignored because lock is held"
          exit 0
        fi
        do_launch_steamlink
        ;;
      mariokart64)
        if ! with_lock; then
          log "launch mariokart64 ignored because lock is held"
          exit 0
        fi
        do_launch_mariokart64
        ;;
      *)
        not_implemented "launch ${*:-}"
        ;;
    esac
    ;;

  ""|-h|--help|help)
    usage
    ;;

  *)
    usage >&2
    exit 2
    ;;
esac
