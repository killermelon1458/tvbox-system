#!/usr/bin/python3
"""Publish canonical idle state without performing actions."""

import argparse
import json
import os
from pathlib import Path
import signal
import sys
import time

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "lib"))

from tvbox.idle.config import load_config
from tvbox.idle.engine import IdleEngine
from tvbox.runtime import read_json, runtime_root


def config_path(value=None):
    return Path(value or os.environ.get(
        "TVBOX_IDLE_CONFIG", str(Path.home() / ".config/tvbox/idle.toml")))


def show_status():
    value = read_json(runtime_root() / "idle-state.json")
    print(json.dumps(value, indent=2, sort_keys=True))
    return 0 if value else 1


def run(path, once=False):
    config = load_config(path)
    engine = IdleEngine(config)
    stopping = False
    reload_requested = False
    try:
        config_mtime = path.stat().st_mtime_ns
    except OSError:
        config_mtime = None

    def stop(*_args):
        nonlocal stopping
        stopping = True

    def reload_now(*_args):
        nonlocal reload_requested
        reload_requested = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGHUP, reload_now)
    while not stopping:
        engine.evaluate()
        if once:
            return 0
        deadline = time.monotonic() + config.poll_interval_seconds
        while not stopping and time.monotonic() < deadline:
            time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))
        try:
            current_mtime = path.stat().st_mtime_ns
        except OSError:
            current_mtime = None
        if reload_requested or current_mtime != config_mtime:
            config = load_config(path)
            engine.reload(config)
            config_mtime = current_mtime
            reload_requested = False
    return 0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("command", nargs="?", choices=["run", "once", "status"],
                        default="run")
    parser.add_argument("--config")
    args = parser.parse_args()
    if args.command == "status":
        return show_status()
    return run(config_path(args.config), once=args.command == "once")


if __name__ == "__main__":
    sys.exit(main())
