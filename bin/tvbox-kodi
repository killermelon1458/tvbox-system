#!/bin/bash
set -u

LOCK="/tmp/tvbox-kodi-launch.lock"
LOG="/home/tvbox/.cache/tvbox-kodi.log"

mkdir -p /home/tvbox/.cache

/usr/local/bin/tvbox-inputctl set-profile kodi_native_minimal 2>/tmp/tvbox-inputctl-kodi.log || true

export HOME=/home/tvbox
export USER=tvbox
export LOGNAME=tvbox
export XDG_RUNTIME_DIR=/run/user/1000
export DISPLAY="${DISPLAY:-:0}"

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  for s in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ -S "$s" ] || continue
    export WAYLAND_DISPLAY="$(basename "$s")"
    break
  done
fi

log() {
  echo "[$(date -Is)] $*" >> "$LOG"
}

kodi_running() {
  pgrep -x kodi.bin >/dev/null 2>&1 || pgrep -x kodi >/dev/null 2>&1
}

open_favourites() {
  kodi-send --action="PlayerControl(Stop)" >> "$LOG" 2>&1 || true
  sleep 1
  kodi-send --action="ActivateWindow(FavouritesBrowser)" >> "$LOG" 2>&1 || true
}

if kodi_running; then
  log "Kodi already running; opening Favourites."
  open_favourites
  /usr/local/bin/tvboxctl set-context kodi >/dev/null 2>&1 || true
  exit 0
fi

exec 9>"$LOCK"
if ! flock -n 9; then
  log "Kodi launch already in progress; exiting."
  exit 0
fi

if kodi_running; then
  log "Kodi appeared while acquiring launch path; opening Favourites."
  open_favourites
  /usr/local/bin/tvboxctl set-context kodi >/dev/null 2>&1 || true
  exit 0
fi

/usr/local/bin/tvbox-audio-hdmi >> "$LOG" 2>&1 || true
log "Launching Kodi with ALSA backend."

# Critical: close FD 9 in the Kodi supervisor so Kodi does not hold the launch lock.
(
  exec 9>&-
  /usr/bin/kodi -fs --audio-backend=alsa "$@"
  kodi_rc=$?
  log "Kodi exited with code $kodi_rc."
  sleep 2
  /usr/local/bin/tvboxctl reconcile-context kodi-exited >> "$LOG" 2>&1 || true
  exit "$kodi_rc"
) >> "$LOG" 2>&1 &

kodi_pid=$!
log "Kodi supervisor started with PID $kodi_pid."
/usr/local/bin/tvboxctl set-context kodi >/dev/null 2>&1 || true

sleep 2
exit 0
