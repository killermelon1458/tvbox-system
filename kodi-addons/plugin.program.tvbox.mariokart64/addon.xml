<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.tvbox.mariokart64"
       name="Mario Kart 64"
       version="1.0.0"
       provider-name="tvbox">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>

  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary>Launch Mario Kart 64</summary>
    <description>Launches Mario Kart 64 through tvboxctl and Mupen64Plus.</description>
    <platform>linux</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
