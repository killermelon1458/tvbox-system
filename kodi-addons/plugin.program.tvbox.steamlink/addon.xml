<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.tvbox.steamlink"
       name="Steam Link"
       version="1.0.0"
       provider-name="tvbox">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>

  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary>Launch Steam Link</summary>
    <description>Launches Steam Link through tvboxctl.</description>
    <platform>linux</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
