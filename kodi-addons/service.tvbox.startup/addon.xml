<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.tvbox.startup"
       name="TVBox Startup"
       version="1.0.0"
       provider-name="TVBox">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.service" library="startup.py" />

    <extension point="xbmc.addon.metadata">
        <summary>TVBox startup actions</summary>
        <description>Opens Kodi Favourites after Kodi starts.</description>
        <platform>linux</platform>
    </extension>
</addon>
